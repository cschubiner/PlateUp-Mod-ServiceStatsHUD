  <Target Name="ValidatePlateUpSetup" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PlateUpInstallDir)\PlateUp.exe')" Text="PlateUp.exe was not found. Update PlateUpInstallDir in Local.props if your install path differs." />
    <Error Condition="!Exists('$(PlateUpInstallDir)\PlateUp_Data\ModUploader.exe')" Text="ModUploader.exe was not found. PlateUp Workshop-era publishing uses PlateUp_Data\ModUploader.exe." />
    <Error Condition="!Exists('$(PlateUpWorkshopDir)\2898033283\0Harmony.dll')" Text="Harmony workshop dependency is missing. Subscribe to item 2898033283." />
    <Error Condition="!Exists('$(PlateUpWorkshopDir)\2898069883\KitchenLib-Workshop.dll')" Text="KitchenLib workshop dependency is missing. Subscribe to item 2898069883." />
    <Error Condition="!Exists('$(PlateUpWorkshopDir)\2949018507\PreferenceSystem-Workshop.dll')" Text="PreferenceSystem workshop dependency is missing. Subscribe to item 2949018507." />
  </Target>

  <Target Name="CopyArtifactsForPlateUp" AfterTargets="Build">
    <ItemGroup>
      <BuiltArtifacts Include="$(TargetPath)" />
      <BuiltArtifacts Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <AssetFiles Include="Assets\**\*.*" />
      <MetadataFiles Include="plateup_mod_metadata.json" Condition="Exists('plateup_mod_metadata.json')" />
    </ItemGroup>

    <MakeDir Directories="$(WorkshopOutputDir)" />
    <MakeDir Directories="$(LocalModOutputDir)" />
    <MakeDir Directories="$(WorkshopOutputDir)\Assets" />
    <MakeDir Directories="$(LocalModOutputDir)\Assets" />
    <Copy SourceFiles="@(BuiltArtifacts)" DestinationFolder="$(WorkshopOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BuiltArtifacts)" DestinationFolder="$(LocalModOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MetadataFiles)" DestinationFolder="$(WorkshopOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MetadataFiles)" DestinationFolder="$(LocalModOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(WorkshopOutputDir)\Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(LocalModOutputDir)\Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
